MYSQL_DATABASE=dhs_db
MYSQL_USER=dhs_user
MYSQL_PASSWORD=ChangeThisMysqlPassword
MYSQL_ROOT_PASSWORD=ChangeThisRootPassword

JWT_SECRET=ChangeThisJwtSecretToALongRandomValue
JWT_EXPIRATION=86400000

# Comma-separated origins used by browser clients.
CORS_ALLOWED_ORIGINS=https://24bp-doghandbook.id.vn,http://24bp-doghandbook.id.vn

# Cloudinary is optional if your deployed demo does not need media upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dog-handbook/media
