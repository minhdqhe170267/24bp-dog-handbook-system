# ========================================
# BACKEND - Spring Boot Environment
# ========================================
# Copy file này thành .env và điền giá trị thật

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dog_handbook
DB_USERNAME=root
DB_PASSWORD=

# Server Configuration
SERVER_PORT=8080

# JWT Configuration (nếu dùng)
JWT_SECRET=
JWT_EXPIRATION=86400000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dog-handbook/media

# Other
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
